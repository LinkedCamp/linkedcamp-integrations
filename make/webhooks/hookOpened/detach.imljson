{
	"url": "https://api.linkedcamp.com/webhooks/{{webhook.externalHookId}}",
	"method": "DELETE",
	"headers": {
		"token": "{{connection.apiKey}}"
	},
	"response": {
		"type": "json",
		"valid": "{{body.success === true}}",
		"error": {
			"401": {
				"message": "Reconnect Linkedcamp: the API key was rejected.",
				"type": "InvalidAccessTokenError"
			},
			"403": {
				"message": "Not allowed for this Linkedcamp key (plan, permission or server-side block)."
			},
			"message": "{{ifempty(body.message, 'Linkedcamp API error')}}"
		}
	},
	"log": {
		"sanitize": [
			"request.headers.token",
			"request.headers.x-api-key"
		]
	}
}
