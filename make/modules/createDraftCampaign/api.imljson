{
	"url": "/mcp",
	"method": "POST",
	"type": "json",
	"body": {
		"jsonrpc": "2.0",
		"id": 1,
		"method": "tools/call",
		"params": {
			"name": "campaign_create",
			"arguments": {
				"title": "{{parameters.title}}",
				"sourceUrl": "{{parameters.sourceUrl}}"
			}
		}
	},
	"response": {
		"output": "{{mcpResult(body, 1)}}"
	}
}
