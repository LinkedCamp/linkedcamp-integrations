{
	"url": "/mcp",
	"method": "POST",
	"type": "json",
	"body": {
		"jsonrpc": "2.0",
		"id": 1,
		"method": "tools/call",
		"params": {
			"name": "lead_note_add",
			"arguments": {
				"leadId": "{{parameters.leadId}}",
				"content": "{{parameters.content}}"
			}
		}
	},
	"response": {
		"output": "{{mcpResult(body, 1)}}"
	}
}
