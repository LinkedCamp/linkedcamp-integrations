{
	"url": "/mcp",
	"method": "POST",
	"type": "json",
	"body": {
		"jsonrpc": "2.0",
		"id": 1,
		"method": "tools/call",
		"params": {
			"name": "message_send",
			"arguments": {
				"conversationId": "{{parameters.conversationId}}",
				"content": "{{parameters.content}}",
				"attachment": "{{if(parameters.attachment.url, parameters.attachment, undefined)}}"
			}
		}
	},
	"response": {
		"output": "{{mcpResult(body, 1)}}"
	}
}
