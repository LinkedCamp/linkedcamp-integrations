	{
		"name": "tags",
		"type": "array",
		"label": "Tag IDs",
		"spec": {
			"type": "text",
			"label": "Tag ID"
		},
		"help": "Leads must carry at least one of these tags."
	},
	{
		"name": "range",
		"type": "collection",
		"label": "Date range",
		"help": "Optional date window. Leave empty for the Linkedcamp default.",
		"spec": [
			{
				"name": "from",
				"type": "date",
				"label": "From"
			},
			{
				"name": "to",
				"type": "date",
				"label": "To"
			}
		]
	},
	{
		"name": "limit",
		"type": "uinteger",
		"label": "Limit",
		"required": false,
		"default": 10,
		"validate": {
			"min": 1,
			"max": 1000
		},
		"help": "Maximum number of bundles to return during one execution cycle."
	}
